[alias]
    co = checkout
    br = branch
    ci = commit
    st = status
    unstage = reset HEAD --
    last = log -2 HEAD -p
    hide = update-index --assume-unchanged
    unhide = update-index --no-assume-unchanged

[user]
    name = ClaudeSeo
    email = clud.seo@gmail.com
    signingkey = ~/.ssh/github

[push]
    autoSetupRemote = true

[core]
    editor = nvim
    # 전역 gitignore: init.sh가 git/.gitignore_global을 ~/.gitignore_global로 심링크
    excludesfile = ~/.gitignore_global

[push]
    default = current

[pull]
    rebase = true
[gpg]
    format = ssh
[commit]
    gpgsign = true
